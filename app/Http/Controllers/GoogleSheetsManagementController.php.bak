    /**
     * Store the new lead from callingapp form
     */
    public function storeLeadFromCallingApp(Request $request)
    {
        $validated = $request->validate([
            'full_name' => 'required|string|max:255',
            'business_name' => 'nullable|string|max:255',
            'email' => 'nullable|email|max:255',
            'whatsapp' => 'nullable|string|max:20',
            'website_url' => 'nullable|url|max:255',
            'business_type' => 'nullable|string|max:100',
            'primary_goal' => 'nullable|string|max:255',
            'budget_range' => 'nullable|string|max:100',
            'score' => 'nullable|string|max:50',
            'tier' => 'nullable|string|max:50',
            'submitted_at' => 'nullable|date',
            'audit_report' => 'nullable|string',
            'audit_report_plain' => 'nullable|string',
        ]);

        try {
            // Add debug logging
            \Log::info('Attempting to store lead from callingapp', [
                'validated_data' => $validated,
                'user_authenticated' => auth()->check(),
                'user_id' => auth()->id()
            ]);

            // Get current user ID or use fallback
            $currentUserId = null;
            if (auth()->check()) {
                $currentUserId = auth()->id();
            } else {
                // Use a default user ID for unauthenticated access
                $currentUserId = 18; // You can change this to any valid user ID
            }

            // Map the fields to Lead model and save
            $lead = \App\Models\Lead::create([
                'name' => $validated['full_name'],
                'company_name' => $validated['business_name'],
                'email' => $validated['email'],
                'phone' => $validated['whatsapp'],
                'website' => $validated['website_url'],
                'industry' => $validated['business_type'],
                'description' => $validated['audit_report'],
                'notes' => $validated['audit_report_plain'],
                'lead_status' => $this->mapTierToStatus($validated['tier'] ?? ''),
                'priority' => 'medium', // Default priority
                'source' => 'callingapp', // Source标识
                'created_by' => $currentUserId,
                // Store additional fields
                'budget' => $this->parseBudgetRange($validated['budget_range'] ?? ''),
                'business_type' => $validated['business_type'],
                'primary_goal' => $validated['primary_goal'],
                'score' => $validated['score'],
                'tier' => $validated['tier'],
                'submitted_at' => $validated['submitted_at'],
                'audit_report' => $validated['audit_report'],
                'audit_report_plain' => $validated['audit_report_plain'],
            ]);

            \Log::info('Lead stored successfully', [
                'lead_id' => $lead->id,
                'lead_name' => $lead->name,
                'source' => $lead->source
            ]);

            return redirect()->route('callingapp.index')
                ->with('success', 'Lead successfully added to Leads Management!');

        } catch (\Exception $e) {
            \Log::error('Error storing lead from callingapp: ' . $e->getMessage());
            
            return redirect()->back()
                ->with('error', 'Failed to add lead. Please try again.')
                ->withInput();
        }
    }

    /**
     * Parse budget range to numeric value
     */
    private function parseBudgetRange($budgetRange)
    {
        if (empty($budgetRange)) {
            return null;
        }

        // Extract numeric values from budget range
        if (preg_match('/\d+/', $budgetRange, $matches)) {
            return (int)$matches[0];
        }

        return null;
    }

    /**
     * Map tier value to lead status
     */
    private function mapTierToStatus($tier)
    {
        $tierMapping = [
            'hot' => 'hot',
            'warm' => 'warm', 
            'cold' => 'cold',
            'qualified' => 'qualified',
            'lost' => 'lost',
            'new' => 'cold', // Default for new leads
            '' => 'cold' // Default for empty tier
        ];
        
        return $tierMapping[$tier] ?? 'cold';
    }

    /**
     * Transfer lead to main leads management system
     */
    public function transferLeadToMainLeads($leadId)
    {
        try {
            // Find the lead in database
            $lead = \App\Models\Lead::find($leadId);
            
            if (!$lead) {
                return response()->json([
                    'success' => false,
                    'message' => 'Lead not found'
                ], 404);
            }
            
            // Check if lead is already from callingapp source
            if ($lead->source !== 'callingapp') {
                return response()->json([
                    'success' => false,
                    'message' => 'This lead cannot be transferred. Only leads added via Calling App can be transferred.'
                ], 400);
            }
            
            // Map the lead data to match main leads management structure
            $mappedData = [
                'name' => $lead->name,
                'company_name' => $lead->company_name,
                'email' => $lead->email,
                'phone' => $lead->phone,
                'website' => $lead->website,
                'industry' => $lead->industry,
                'description' => $lead->description,
                'notes' => $lead->notes,
                'lead_status' => $lead->lead_status,
                'priority' => $lead->priority ?: 'medium',
                'source' => 'callingapp_transfer', // Mark as transferred from callingapp
                'created_by' => auth()->id() ?: 18,
                // Additional fields
                'budget' => $lead->budget,
                'business_type' => $lead->business_type,
                'primary_goal' => $lead->primary_goal,
                'score' => $lead->score,
                'tier' => $lead->tier,
                'submitted_at' => $lead->submitted_at,
                'audit_report' => $lead->audit_report,
                'audit_report_plain' => $lead->audit_report_plain,
            ];
            
            // Create new lead in main leads management
            $newLead = \App\Models\Lead::create($mappedData);
            
            // Delete the original lead from callingapp
            $lead->delete();
            
            \Log::info('Lead transferred to main leads management', [
                'original_lead_id' => $leadId,
                'new_lead_id' => $newLead->id,
                'lead_name' => $lead->name
            ]);
            
            return response()->json([
                'success' => true,
                'message' => 'Lead successfully transferred to Leads Management!',
                'new_lead_id' => $newLead->id
            ]);
            
        } catch (\Exception $e) {
            \Log::error('Error transferring lead: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Failed to transfer lead: ' . $e->getMessage()
            ], 500);
        }
    }
}
